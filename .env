# ==========================================================
# Configurações do Coletor e Processador CNPJ
# ==========================================================

# URL ou Token de Compartilhamento da Receita Federal
RECEITA_SHARE_URL=https://arquivos.receitafederal.gov.br/index.php/s/YggdBLfdninEJX9

# Mês padrão de extração ('latest' ou 'AAAA-MM')
DEFAULT_MONTH=latest

# Tamanho do lote para inserção (UPSERT)
BATCH_SIZE=20000

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cnpj_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_POOL_MIN=1
POSTGRES_POOL_MAX=10

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_QUEUE=cnpj_tasks_queue

